rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation for MenuItem
    function isValidMenuItem(data) {
      return data.keys().hasAll(['categoryId', 'name', 'price', 'description', 'imageUrl']) &&
             data.keys().size() >= 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price > 0 &&
             data.categoryId is string &&
             data.imageUrl is string;
    }

    // Validation for Order
    function isValidOrder(data) {
      return data.keys().hasAll(['tableNumber', 'items', 'total', 'status', 'createdAt']) &&
             data.tableNumber is int && data.tableNumber >= 1 && data.tableNumber <= 100 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.status in ['pending', 'preparing', 'done', 'cancelled'] &&
             data.createdAt is string; // Since we store as ISO string in frontend
    }

    // 1. Categories & Menu Items (Read-only for everyone, Write for none in this demo)
    match /categories/{catId} {
      allow read: if true;
    }
    match /menuItems/{itemId} {
      allow read: if true;
    }

    // 2. Orders
    match /orders/{orderId} {
      // Allow customers to create orders
      allow create: if isValidId(orderId) && 
                      isValidOrder(incoming()) && 
                      incoming().status == 'pending';

      // Allow listing for dashboard (In production, restrict to staff)
      allow list: if true; 
      allow get: if true;

      // Update limited to status transitions
      allow update: if isValidOrder(incoming()) && (
        (existing().status == 'pending' && incoming().status == 'preparing' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (existing().status == 'preparing' && incoming().status == 'done' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }
  }
}
